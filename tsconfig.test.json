{
  // The tests, compiled to dist-test/. They import the BUILT package
  // (../dist/*.js), so `npm run build` runs first (npm test does).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "test",
    "outDir": "dist-test",
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["test"]
}
